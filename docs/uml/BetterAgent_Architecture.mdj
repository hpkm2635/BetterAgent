							"parentStyle": false,
							"left": 1032,
							"top": 80,
							"width": 167,
							"height": 64,
							"text": "限制单位时间内的 API 调用频率，防止触发 Telegram 的 PeerFloodError。"
						},
						{
							"_type": "UMLTextBoxView",
							"_id": "AAAAAAGfxacT1A7+te0=",
							"_parent": {
								"$ref": "AAAAAAGfxaLPowhXvY4="

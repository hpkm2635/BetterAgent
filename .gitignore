# ==========================================
# 1. 敏感凭据与环境配置 (绝对不能上传)
# ==========================================
.env
*.env
*.local
*.local.*
!.env.example
cert*/
*.pem
*.key
*.crt

# ==========================================
# 2. Python 虚拟环境与缓存
# ==========================================
.venv/
venv*/
venv_win/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ==========================================
# 3. Node.js & 前端 (Vite/Vue3) 构建产物
# ==========================================
node_modules/
dist/
out/
.output/
.eslintcache/
.vite-inspect/
.turbo/
**/.turbo/
**/*.tsbuildinfo

# ==========================================
# 4. Go & 二进制编译产物
# ==========================================
betteragent-core
betteragent-core.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# ==========================================
# 5. 日志、临时文件与本地数据库
# ==========================================
logs/
*.log
*.logs
temp/
**/temp/
*.db
*.sqlite
*.sqlite3
.postgres/

# ==========================================
# 6. 大文件防爆 (AI 模型权重与大型媒体资产)
# ==========================================
# 忽略 PyTorch/ONNX 等超大模型权重，防止超过 GitHub 100MB 限制
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf

# 忽略临时音视频二进制文件
*.pcm
*.wav
*.mp3
*.mp4

# ==========================================
# 7. IDE、AI 助手与操作系统临时文件
# ==========================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/

# AI 助手本地运行状态与缓存 (Claude / Cursor / Gemini)
.devcontainer/
.claude/
**/.claude/
.cursor/
**/.cursor/
.gemini/
**/.gemini/

# ==========================================
# 版权资产隔离 (Booth 购买的付费 3D/VRM 模型)
# ==========================================
VRM/*
**/VRM/*
*.vrm
*.vrm.meta

# 1. 配置文件隔离
config/config.yaml

# 2. Telegram 登录 Session 凭据（高危！防泄露）
*.session
*.session-journal
*.session.json

# 3. 本地虚拟环境目录
venv_win/
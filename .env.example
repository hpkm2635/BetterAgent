# Sensitive API Keys & Credentials ONLY
# Non-sensitive infrastructure URLs (NATS, Redis, Qdrant) are defined in config/config.yaml

# NATS Message Bus Credentials (REQUIRED)
# The bus carries private conversation data and action commands between every
# service (Go core, memory, cognitive, tts) -- it must never run unauthenticated.
# Generate a strong random password, e.g.: openssl rand -hex 24
NATS_USER=betteragent
NATS_PASSWORD=change_me_to_a_strong_random_secret

# WebGateway Access Token (REQUIRED)
# Shared secret required to open the /ws digital-human WebSocket endpoint
# (port 8080). Must match between Go core (WEBGATEWAY_TOKEN) and frontend (VITE_BETTERAGENT_WS_TOKEN).
WEBGATEWAY_TOKEN=change_me_to_a_strong_random_secret
VITE_BETTERAGENT_WS_TOKEN=change_me_to_a_strong_random_secret

# WebGateway Allowed Origins (Optional)
# Comma-separated glob patterns (e.g. "example.com,*.example.com") restricting
# which browser Origins may open the /ws WebSocket cross-origin. The
# WEBGATEWAY_TOKEN above is the real access control either way -- this is
# defense in depth against a browser page that already has a valid token.
# Leave unset during local dev (stage-web on a different port) or if your
# frontend is served from a different domain than the Go core.
WEBGATEWAY_ALLOWED_ORIGINS=

# Game Event Token (Optional)
# Shared secret required to POST /api/game-event on the dedicated, loopback-only
# game-event listener (default 127.0.0.1:8090, see core_engine.game_event_bind_addr
# in config.yaml) -- e.g. the upcoming Slay the Spike 2 C# mod hook feeding the
# UrgeEngine. Leave unset to disable the endpoint entirely (it returns 503, the
# core does NOT fail to start over this being missing, unlike WEBGATEWAY_TOKEN).
# Generate one with: openssl rand -hex 24
GAME_EVENT_TOKEN=

# Admin Backend Access Token (Optional)
# Shared secret required to call the Admin REST API (port 8094) when set.
# The backend accepts it as either `X-Admin-Token: <secret>` or
# `Authorization: Bearer <secret>`. Leave unset during local dev to keep the
# admin panel open; set it before any internet-facing deploy. Generate with:
# openssl rand -hex 24
# NOTE: the Admin backend reads admin/backend/.env, and the Admin UI dev proxy
# reads admin/frontend/.env -- set the same value in both to keep the UI working.
ADMIN_SECRET_KEY=

# Redis Password (REQUIRED)
# Redis stores every user's short-term conversation buffer (ShortTermMemoryBuffer),
# keyed by user_id -- an unauthenticated instance would leak everyone's recent
# chat history to anyone who can reach port 6379. Generate with: openssl rand -hex 24
REDIS_PASSWORD=change_me_to_a_strong_random_secret

# Qdrant API Key (REQUIRED)
# NOTE: services/memory/vector_store.py is currently an in-memory stub and does
# not yet talk to Qdrant, so this only locks down the container itself ahead of
# that integration landing. Generate with: openssl rand -hex 24
QDRANT_API_KEY=change_me_to_a_strong_random_secret

# Telegram Credentials (Optional)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# LLM Providers & AI Services
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key
COSYVOICE_API_KEY=your_cosyvoice_api_key
QWEN_API_KEY=your_qwen_api_key
# Admin backend runtime configuration.
# Copy this file to `.env` in the same directory and adjust values, e.g.:
#   cp .env.example .env
# `.env` is gitignored; this `.env.example` is committed as reference doc.

# Redis user profiles & session history (REQUIRED to see real users/sessions).
# The Admin panel reads user profiles from Redis under
# `betteragent:profile:{user_id}` (with `user_profile:{user_id}` as a legacy
# fallback) and session history from `short_term:{chat_id}`. Credentials MUST
# match the main BetterAgent deployment (root .env), otherwise the endpoints
# silently return empty lists.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=change_me_to_a_strong_random_secret

# Optional overrides (defaults shown, commented out).
# ADMIN_PORT=8094          # Admin REST API listen port
# PERSONA_DIR=../config/persona   # persona YAML directory (absolute or repo-root-relative)
# ADMIN_DB_PATH=./admin.db        # SQLite path for soft-delete flags
# CAMPUS_KB_URL=http://127.0.0.1:8093   # upstream campus_kb service
# ADMIN_SECRET_KEY=         # leave empty for local dev; set before any
#                           # internet-facing deploy. Same value must be set in
#                           # admin/frontend/.env for the Vite proxy to work.
